# Copy to .env (never commit .env). docker-compose.yml already sets DATABASE_URL and PAYSWIFT_BASE_URL.

# --- required by the service ---
DATABASE_URL=postgresql://qd:qd-local-only@localhost:5432/qd
PAYSWIFT_BASE_URL=http://localhost:8081
# Bearer token for approve / reject / resolve on the ops page. Empty disables ops actions.
OPS_TOKEN=change-me

# --- LLM (optional). Empty LLM_PROVIDER or LLM_API_KEY => deterministic rules planner. ---
# anthropic | openai  ("openai" = any OpenAI-compatible API: OpenAI, Groq, Gemini, local)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# e.g. https://api.groq.com/openai/v1 or https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=4
LLM_MAX_STEPS=4

# --- optional hardening ---
# If set, POST /messages requires header X-Webhook-Secret with this value.
WEBHOOK_SECRET=
POSTGRES_PASSWORD=qd-local-only

# --- finance rules (defaults match the brief) ---
AUTO_PAY_ENABLED=true
AUTO_PAY_LIMIT_INR=200
DISPUTE_WINDOW_DAYS=7
# live = agent pays small disputes itself; shadow = agent decides, ops approves every payout
# (the ops page then shows how often ops agreed with the agent).
AUTO_PAY_MODE=live
# Ceiling on all automatic payouts per business day, across all riders. 0 = no ceiling.
AUTO_PAY_DAILY_BUDGET_INR=20000
# A rider sending more than this per hour gets a holding reply and no agent actions. 0 = no limit.
RIDER_MAX_MESSAGES_PER_HOUR=30

# --- tuning (defaults are fine) ---
REPLY_BUDGET_SECONDS=7
PAYSWIFT_INLINE_TIMEOUT_SECONDS=3
PAYSWIFT_WORKER_TIMEOUT_SECONDS=12
PAYSWIFT_MAX_POSTS_PER_10S=20
PAYOUT_MAX_ATTEMPTS=25
WORKER_ENABLED=true
LOG_LEVEL=INFO
MAX_CONCURRENT_TURNS=12
